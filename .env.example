# Copy to .env.local and fill in real values there. .env.local is
# gitignored; never commit real secrets or real addresses.

# Postgres connection string (Neon). Optional in development: without it,
# content reads fall back to seed/content.json (see lib/content/read.ts),
# and the contact form's rate limiter fails open (see lib/contact/rateLimit.ts).
DATABASE_URL=

# Resend API key used to actually send contact-form email
# (lib/contact/mailer.ts). Without it, in development the form just logs the
# submission instead of sending; in production, sending fails loudly.
RESEND_API_KEY=

# --- Two DIFFERENT email addresses. Do not conflate them. -----------------

# CONTACT_TO_EMAIL: the private DELIVERY address. Read server-side only, by
# lib/contact/mailer.ts, to decide where the working contact form's email
# actually gets sent. Never rendered into any page, never sent to the
# browser in any form.
CONTACT_TO_EMAIL=

# PUBLIC_CONTACT_EMAIL: the address that is safe to PUBLISH. Read
# server-side by components/sections/Contact.tsx and rendered into the
# <noscript> fallback in components/ContactForm.tsx, which lands in the raw
# HTML of every page, where email harvesters can read it. Deliberately
# separate from CONTACT_TO_EMAIL so the owner's real delivery inbox is never
# the one exposed on the public page. If this is left unset, the fallback
# renders with no address at all rather than silently falling back to
# CONTACT_TO_EMAIL; it never leaks the delivery address.
PUBLIC_CONTACT_EMAIL=

# Salt for hashing sender IPs before they are stored for rate limiting
# (lib/contact/rateLimit.ts), and also the Auth.js session-signing key once
# the editor's env vars below are set. Any random string.
AUTH_SECRET=

# --- Editor auth (Auth.js + GitHub OAuth). authConfigured() (lib/auth/
# index.ts) checks AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, and ADMIN_GITHUB_LOGIN
# below plus AUTH_SECRET above (four total); without all four, /login reads
# "Editor not configured" and the public site is unaffected. AUTH_URL below
# is NOT part of that check - it is Auth.js's own canonical-origin setting,
# required for correct callback URLs in production but irrelevant to
# authConfigured(). Placeholders only below, never real values. See
# docs/EDITOR.md for the full local-dev and production setup. --------------

# GitHub OAuth app client ID (the dev app for localhost, or the production
# app for bryangmills.com).
AUTH_GITHUB_ID=your-github-oauth-app-client-id

# GitHub OAuth app client secret, paired with AUTH_GITHUB_ID above.
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret

# The GitHub login (not display name) allowed to sign in as the site owner;
# any other GitHub account is refused at sign-in and again on every save.
ADMIN_GITHUB_LOGIN=your-github-username

# Auth.js's canonical origin: http://localhost:3000 in development,
# https://bryangmills.com in production.
AUTH_URL=http://localhost:3000

# --- Optional, scripts/check-mobile.mjs only, not used by the app itself --
# CHECK_URL=http://localhost:3000
# CHROME_PATH=
